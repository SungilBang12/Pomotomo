# Pomotomo 환경 변수 템플릿
# -----------------------------------------------------------------------------
# 이 앱은 백엔드·외부 API·계정이 없어 동작에 필요한 시크릿이 없습니다.
# 모든 데이터(사진·이름·설정)는 사용자 기기에만 로컬로 저장됩니다.
#
# 사용법:
#   cp .env.example .env
#   필요한 값을 채운 뒤 저장 (실제 .env 는 .gitignore 로 커밋되지 않습니다)
#
# 아래는 향후 확장을 위한 선택적 예시입니다. 현재는 비워 두어도 정상 동작합니다.
# -----------------------------------------------------------------------------

# Tauri 개발 서버 로그 레벨 (예: error | warn | info | debug | trace)
# RUST_LOG=info

# 개발 빌드에서 WebView 개발자 도구 강제 활성화 (1 = 켜기)
# TAURI_DEV_DEVTOOLS=
